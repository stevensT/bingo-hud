<Window x:Class="BingoHud.App.DetailPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bingo"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <!-- A conventional window, unlike the HUD. This one is read rather than glanced at, so it
         keeps its title bar: it can be moved, closed and alt-tabbed the way every other window
         can, and none of that has to be reinvented.

         Centred on the screen rather than on the HUD it was opened from. The HUD lives parked
         against an edge, so a panel centred on it would open half off the screen. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- The stock button is a light control, which on this panel reads as a piece of another
             window. Templated rather than merely recoloured because a WPF button keeps its own
             chrome on hover and press otherwise, and the light chrome is the part that shows. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16,14,16,16">
        <!-- The state Bingo is in, and what to do about it (AC-9, AC-10, AC-11). Above the
             numbers rather than below them, because when it is showing at all it qualifies
             everything under it: a reading can be on screen and out of date at the same time,
             and the order these are read in is what says so. Hidden entirely when a current
             reading has nothing wrong with it. -->
        <Border x:Name="StatusArea" Background="#33FFFFFF" CornerRadius="4" Padding="10,8"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusAdvice" Foreground="#CCFFFFFF" TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="WINDOWS" Style="{StaticResource Heading}" />
        <!-- Rows are built in code from what Core decided. Nothing here composes a string. The
             columns are shared within each grid so the figures line up down the panel. -->
        <Grid x:Name="Windows">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock Text="PER-MODEL WEEKLY CAPS" Style="{StaticResource Heading}" Margin="0,18,0,6" />
        <Grid x:Name="PerModelCaps">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="PerModelCapsEmptyState" Foreground="#99FFFFFF" TextWrapping="Wrap" />

        <Border Background="#33FFFFFF" Height="1" Margin="0,18,0,14" />

        <Grid x:Name="Facts">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- A manual refresh, held to the same floor as an automatic poll (AC-28). The button
             cannot make Bingo poll faster; when it is refused it says so, and says when asking
             again will work. -->
        <Button x:Name="Refresh" Content="Refresh now" Margin="0,16,0,0" Padding="10,4"
                HorizontalAlignment="Left" />
        <TextBlock x:Name="RefreshNotice" Foreground="#99FFFFFF" TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </StackPanel>
</Window>
