<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BingoHud.Core\BingoHud.Core.csproj" />
  </ItemGroup>

  <!--
    Recorded endpoint responses live at tests/fixtures/usage, outside any project, because
    they are captured artefacts belonging to the repository rather than source belonging to
    this project. Link them into the output directory so tests can read them by path.

    The .meta.json files are copied too: they carry the status code and headers of each
    capture, which the error-taxonomy tests will need.
  -->
  <ItemGroup>
    <Content Include="..\fixtures\usage\*.json">
      <Link>fixtures\usage\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The shell's source files, linked into the output so a test can read them. Task 6.11 fixes the
    rule that every call into Win32 lives in one file, and reading the source is the only way to
    assert that from here: this project references Core alone, deliberately, and taking a
    reference on the WPF app in order to reflect over it would breach the very seam SeamTests
    defends.
  -->
  <ItemGroup>
    <Content Include="..\..\src\BingoHud.App\**\*.cs"
             Exclude="..\..\src\BingoHud.App\obj\**;..\..\src\BingoHud.App\bin\**">
      <Link>app-sources\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
